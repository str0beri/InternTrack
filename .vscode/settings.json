
{
  // Prevents incorrect Ionic component auto-import suggestions.
  "js/ts.preferences.autoImportFileExcludePatterns": [
    "@ionic/angular/types/ionic-angular-lazy.d.ts",
    "@ionic/angular/types/ionic-angular-common.d.ts"
  ],

  // Enable Deno only for Supabase Edge Functions.
  "deno.enable": true,
  "deno.enablePaths": [
    "./supabase/functions"
  ]
}
